root = true

# Unreal Engine source — tabs, c++20.
[*]
charset = utf-8
end_of_line = crlf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,cc,c,inl}]
indent_style = tab

[*.{md,json,jsonc,yml,yaml,uplugin,uproject}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{cs,xml}]
indent_style = space
indent_size = 4
