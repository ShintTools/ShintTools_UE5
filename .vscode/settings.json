{
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.formatting": "disabled",
  "C_Cpp.workspaceParsingPriority": "medium",

  "[cpp]":  { "editor.tabSize": 4, "editor.insertSpaces": false },
  "[c]":    { "editor.tabSize": 4, "editor.insertSpaces": false },
  "[h]":    { "editor.tabSize": 4, "editor.insertSpaces": false },
  "[hpp]":  { "editor.tabSize": 4, "editor.insertSpaces": false },

  "files.associations": {
    "*.uplugin":  "json",
    "*.uproject": "json",
    "*.h":        "cpp"
  },

  "files.exclude": {
    "Binaries":         true,
    "Intermediate":     true,
    "DerivedDataCache": true,
    "Saved":            true,
    "*.sln":            true,
    "*.suo":            true,
    ".vs":              true
  },

  "search.exclude": {
    "Binaries":         true,
    "Intermediate":     true,
    "DerivedDataCache": true,
    "Saved":            true
  }
}
